# ShortsForge API Keys — copy this file to .env and fill in your chosen provider key(s).
# Never commit .env to version control.

# LLM Provider Keys (set the one matching llm.provider in config.yaml)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional TTS Provider Keys (only needed if tts.provider is "openai" or "elevenlabs";
# the default "edge" provider requires no API key)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
